{
  "name": "wexample/symfony-data-sync",
  "description": "Reconciles local Doctrine entities with external data sources: definitions, adapters, links, matching, plans and dry runs",
  "type": "library",
  "license": "MIT",
  "version": "2.0.6",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDataSync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyDataSync\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=11.0.0",
    "doctrine/orm": "^3.0",
    "symfony/property-access": "*",
    "symfony/string": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "wexample/symfony-testing": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
